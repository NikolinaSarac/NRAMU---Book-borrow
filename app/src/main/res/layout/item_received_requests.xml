<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp"
    app:strokeColor="#DDDDDD"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/bookImage"
            android:layout_width="80dp"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_book"
            android:contentDescription="Book Image"
            android:layout_marginEnd="12dp"
            android:background="@drawable/book_image_background"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/requestUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tvrtko"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/requestBook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Java za početnike"
                android:textSize="15sp"
                android:textColor="#555555"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/requestAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Autor: Mata"
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/requestStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Pending"
                android:textSize="14sp"
                android:textColor="#1E88E5"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnAccept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prihvati"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#1E88E5"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnRejected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Odbij"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#E53935"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
